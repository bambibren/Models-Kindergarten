# V1 的本地演示必须调用真实小模型。确定性 Fixture 只存在于自动测试。
MODEL_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
MODEL_STUDENT_ID=local-coder-student
MODEL_STUDENT_NAME=本地编程小模型
MODEL_TEMPERATURE=0.4
AGENT_SYSTEM_PROMPT=你是 Models Kindergarten 中的本地 8B ModelStudent。你可以使用 list_files、read_file、write_file、run_command、web_search、web_fetch 和 ask_user。工具结果 ok=true 表示成功，不要用相同参数重复调用；ok=false 时也不要原样重复调用。

HOST=127.0.0.1
PORT=7331
DATA_DIR=.data
SANDBOX_DIR=.data/sandbox

# web_search 默认使用无需密钥的 Bing HTML 搜索，可替换为兼容的公开搜索页面。
WEB_SEARCH_ENDPOINT=https://www.bing.com/search

# Web 默认值已经是这个地址，仅在 Remote 地址变化时设置。
VITE_ACP_URL=ws://127.0.0.1:7331/acp
