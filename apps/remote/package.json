{
  "name": "@kindergarten/remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "start:dist": "node --env-file-if-exists=../../.env dist/index.js",
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --external:@agentclientprotocol/sdk --external:@agentclientprotocol/sdk/* --external:ws --outfile=dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@kindergarten/contracts": "workspace:*",
    "@kindergarten/evaluation-exporter": "workspace:*",
    "@kindergarten/runtime-observation": "workspace:*",
    "ws": "8.21.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.1",
    "tsx": "4.23.7"
  }
}
