{
  "name": "@kindergarten/remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "start:dist": "node --env-file-if-exists=../../.env dist/index.js",
    "secret:init": "node --env-file-if-exists=../../.env --import tsx src/secrets/secret-init.ts",
    "skill:install": "node --env-file-if-exists=../../.env --import tsx src/skills/skill-cli.ts",
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --external:@agentclientprotocol/sdk --external:@agentclientprotocol/sdk/* --external:@modelcontextprotocol/client --external:@modelcontextprotocol/client/* --external:ajv --external:pptxgenjs --external:ws --external:yaml --outfile=dist/index.js && esbuild src/auth/auth-user-cli.ts --bundle --platform=node --format=esm --outfile=dist/auth-user-cli.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@kindergarten/contracts": "workspace:*",
    "@kindergarten/evaluation-contract": "workspace:*",
    "@kindergarten/runtime-observation": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "ajv": "8.17.1",
    "pptxgenjs": "4.0.1",
    "ws": "8.21.2",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.1",
    "tsx": "4.23.7"
  }
}
