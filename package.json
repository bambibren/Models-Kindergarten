{
  "name": "models-kindergarten",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @kindergarten/remote --filter @kindergarten/web --filter @kindergarten/resource dev",
    "dev:remote": "pnpm --filter @kindergarten/remote dev",
    "dev:web": "pnpm --filter @kindergarten/web dev",
    "dev:resource": "pnpm --filter @kindergarten/resource dev",
    "start:dist": "pnpm --filter @kindergarten/remote start:dist",
    "secret:init": "pnpm --filter @kindergarten/remote secret:init",
    "auth:user": "pnpm --filter @kindergarten/remote exec tsx src/auth/auth-user-cli.ts",
    "deploy:secret:init": "node deploy/scripts/secret-init.mjs",
    "deploy:build": "sh deploy/scripts/preview-build.sh",
    "deploy:preview": "sh deploy/scripts/preview-all.sh",
    "deploy:preview:up": "sh deploy/scripts/preview-up.sh",
    "deploy:preview:smoke": "node deploy/scripts/preview-smoke.mjs",
    "deploy:preview:down": "sh deploy/scripts/preview-down.sh",
    "deploy:cloud:ip": "node deploy/scripts/cloud-deploy.mjs ip",
    "deploy:cloud:domain": "node deploy/scripts/cloud-deploy.mjs domain",
    "deploy:validate": "node deploy/scripts/validate-pptx-seccomp.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm deploy:validate",
    "audit:comments": "node scripts/documentation/audit-chinese-comments.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
