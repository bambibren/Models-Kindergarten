# 由 pnpm deploy:cloud:domain 根据 --domain、--office-domain 和 release manifest 生成。
# Docker 内部服务名、监听地址和端口统一读取同目录的 internal.env。
COMPOSE_PROJECT_NAME=mk
DEPLOYMENT_PROFILE=cloud
AUTH_MODE=required
PUBLIC_ORIGIN=https://mk.example.com
ONLYOFFICE_PUBLIC_URL=https://office.mk.example.com
MK_SITE_ADDRESS=mk.example.com
MK_OFFICE_SITE_ADDRESS=office.mk.example.com
MK_HTTP_BIND=0.0.0.0
MK_HTTP_PORT=80
MK_OFFICE_BIND=127.0.0.1
MK_OFFICE_PORT=8080
MK_HTTPS_BIND=0.0.0.0
MK_HTTPS_PORT=443
MK_DATA_PATH=/srv/mk/data/app
MK_MASTER_KEY_FILE=/srv/mk/secrets/mk_master_key
ONLYOFFICE_JWT_ENABLED=true
