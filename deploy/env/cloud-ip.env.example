# 由 pnpm deploy:cloud:ip 根据 --ip 和 release manifest 生成，不直接照抄部署。
COMPOSE_PROJECT_NAME=mk
DEPLOYMENT_PROFILE=cloud
AUTH_MODE=development
PUBLIC_ORIGIN=http://203.0.113.10
ONLYOFFICE_PUBLIC_URL=http://203.0.113.10:8080
MK_SITE_ADDRESS=http://:8080
MK_OFFICE_SITE_ADDRESS=http://:8081
MK_HTTP_BIND=0.0.0.0
MK_HTTP_PORT=80
MK_OFFICE_BIND=0.0.0.0
MK_OFFICE_PORT=8080
MK_HTTPS_BIND=127.0.0.1
MK_HTTPS_PORT=7443
MK_DATA_PATH=/srv/mk/data/app
MK_MASTER_KEY_FILE=/srv/mk/secrets/mk_master_key
ONLYOFFICE_JWT_ENABLED=false
