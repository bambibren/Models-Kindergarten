COMPOSE_PROJECT_NAME=mk-preview
# Docker 内部服务名、监听地址和端口统一读取同目录的 internal.env。
MK_WEB_IMAGE=models-kindergarten/mk-web:preview
MK_RUNTIME_IMAGE=models-kindergarten/mk-runtime:preview
DEPLOYMENT_PROFILE=docker-preview
AUTH_MODE=development
PUBLIC_ORIGIN=http://127.0.0.1:7410
ONLYOFFICE_PUBLIC_URL=http://127.0.0.1:7411
MK_SITE_ADDRESS=http://:8080
MK_OFFICE_SITE_ADDRESS=http://:8081
MK_HTTP_BIND=127.0.0.1
MK_HTTP_PORT=7410
MK_OFFICE_BIND=127.0.0.1
MK_OFFICE_PORT=7411
MK_HTTPS_BIND=127.0.0.1
MK_HTTPS_PORT=7443
MK_DATA_PATH=./local/data/app
MK_MASTER_KEY_FILE=./local/secrets/mk_master_key
ONLYOFFICE_JWT_ENABLED=false
